"VertexLitGeneric"
{
	"$basetexture"			"models\proppertextures\wood\paintedwood1_d"
	"$bumpmap" 			"models\proppertextures\wood\wood6_n"
    "$phongexponenttexture" "models\proppertextures\paint\acrylic2\acrylic2hw_e"

	"$normalmapalphaenvmapmask"	"0"
	"$basemapalphaphongmask" 		"0"

	"$phong"			"1"
	"$phongalbedotint"		"0"
	"$phongtint"                  	"[1 1 1]"
	"$phongboost"                  	"0"
	"$phongexponent"             	 "30"
	"$phongfresnelranges"           "[1 5 8]"
	
	"$rimlight"               "1"
	"$rimlightexponent"       "10"
	"$rimlightboost"          "0.3"

	"$detail" "detail\noise_detail_01"
	"$detailscale" "10.563"
	"$detailblendfactor" "0.2"
	"$detailblendmode" "0"

	
	"$override" "{255 255 255}"
    "Proxies"
    {
        "EnvMapDarken"
        {
            "min" "0"
            "max" "0.05"
        }
